PUBLIC_MAPTILER_KEY=YOUR_MAPTILER_KEY
# [embed] GraphHopper routing endpoint (used by routing.ts). Defaults to upstream when unset.
VITE_GRAPHHOPPER_URL=https://graphhopper.gpx.studio
# [embed] MapLibre style JSON endpoint (used by layers.ts). Defaults to upstream when unset.
VITE_STYLES_URL=https://styles.gpx.studio
# [embed] Tiles + terrain DEM endpoint (used by layers.ts and utils.ts). Defaults to upstream when unset.
VITE_TILES_URL=https://tiles.gpx.studio
# [embed] Overpass POI endpoint (used by overpass-layer.ts). Defaults to upstream when unset.
VITE_OVERPASS_URL=https://overpass.gpx.studio
