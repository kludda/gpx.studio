PUBLIC_MAPTILER_KEY=YOUR_MAPTILER_KEY

# [embed] gpx.studio service endpoints. Each is OPTIONAL — when unset the code
# falls back to the upstream default shown on the right. Set them to a
# CORS-rewriting reverse proxy (see gpx.studio-bridge/README.md) to run the
# embed in everyday browsers. Example values below point at a single proxy host:
# VITE_GRAPHHOPPER_URL=https://gpx.example.com/gh        # default: https://graphhopper.gpx.studio
# VITE_STYLES_URL=https://gpx.example.com/styles         # default: https://styles.gpx.studio
# VITE_TILES_URL=https://gpx.example.com/tiles           # default: https://tiles.gpx.studio
# VITE_ELEVATION_TILES_URL=https://tiles.mapterhorn.com # default: https://tiles.gpx.studio/mapterhorn — DEM tiles, hit only when drawing with routing OFF. Base includes the path segment, so it can point at the CORS-open mapterhorn source directly (no proxy).
# VITE_OVERPASS_URL=https://gpx.example.com/overpass     # default: https://overpass.gpx.studio

# [embed] postMessage origin allowlist (used by embed.ts). Comma-separated.
# Unset = trust-on-first-use (allows any parent — POC default). Set to the
# bridge's origin to lock the editor down once the embed host is known:
# VITE_EMBED_ALLOWED_ORIGINS=https://gpx.example.com
